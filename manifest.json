{
  "manifest_version": 3,
  "name": "Meeting Transcripts",
  "version": "2.7.0",
  "description": "Records the live captions of Google Meet, Microsoft Teams and Zoom calls in Chrome and saves each call as a Word document.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.zoom.us/wc/*",
    "https://zoom.us/wc/*"
  ],
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume recording"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "lib/shared.js",
        "content/dom.js",
        "content/platforms/meet.js",
        "content/recorder.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "lib/shared.js",
        "content/dom.js",
        "content/platforms/teams.js",
        "content/recorder.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zoom.us/wc/*",
        "https://zoom.us/wc/*"
      ],
      "js": [
        "lib/shared.js",
        "content/dom.js",
        "content/platforms/zoom.js",
        "content/recorder.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Meeting Transcripts"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
